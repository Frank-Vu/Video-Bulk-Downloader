{
  "manifest_version": 3,
  "name": "Video Bulk Downloader",
  "version": "2.7.4",
  "description": "Bulk download 4K (AV1, H.264 fallback) videos from pasted list of video pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "video-bulk-downloader@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.eporner.com/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open Video Bulk Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
